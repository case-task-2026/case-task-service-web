<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="utf-8">
    <title>{% if pageTitle %}{{ pageTitle }} - {% endif %}Case Task Service</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1d70b8">

    <link rel="stylesheet" href="/govuk/govuk-frontend.min.css">
    <link rel="stylesheet" href="/public/styles/application.css">
  </head>

  <body class="govuk-template__body">
    <script>
      document.body.className += ' js-enabled'
    </script>

    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">
      Skip to main content
    </a>

    <header class="govuk-header" data-module="govuk-header">
      <div class="govuk-header__container govuk-width-container">
        <div class="govuk-header__logo">
          <a href="/" class="govuk-header__link govuk-header__link--homepage">
            <span class="govuk-header__logotype">
              <span class="govuk-header__logotype-text">
                GOV.UK
              </span>
            </span>
          </a>
        </div>

        <div class="govuk-header__content">
          <a href="/" class="govuk-header__link govuk-header__service-name">
            Case Task Service
          </a>

          <nav aria-label="Menu" class="govuk-header__navigation">
            <ul class="govuk-header__navigation-list">
              <li class="govuk-header__navigation-item">
                <a
                  class="govuk-header__link {% if navigation.home %}app-header-navigation-link--active{% endif %}"
                  href="/"
                  {% if navigation.home %}aria-current="page"{% endif %}
                >
                  Home
                </a>
              </li>

              <li class="govuk-header__navigation-item">
                <a
                  class="govuk-header__link {% if navigation.tasks %}app-header-navigation-link--active{% endif %}"
                  href="/tasks"
                  {% if navigation.tasks %}aria-current="page"{% endif %}
                >
                  Tasks
                </a>
              </li>

              <li class="govuk-header__navigation-item">
                <a
                  class="govuk-header__link {% if navigation.createTask %}app-header-navigation-link--active{% endif %}"
                  href="/tasks/new"
                  {% if navigation.createTask %}aria-current="page"{% endif %}
                >
                  Create task
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <div class="govuk-width-container">
      <div class="govuk-phase-banner">
        <p class="govuk-phase-banner__content">
          <strong class="govuk-tag govuk-phase-banner__content__tag">
            Prototype
          </strong>
          <span class="govuk-phase-banner__text">
            This is a technical test implementation for managing caseworker tasks.
          </span>
        </p>
      </div>

      {% block beforeContent %}{% endblock %}

      <main class="govuk-main-wrapper" id="main-content">
        {% block content %}{% endblock %}
      </main>
    </div>

    <footer class="govuk-footer">
      <div class="govuk-width-container">
        <div class="govuk-footer__meta">
          <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
            <h2 class="govuk-visually-hidden">Support links</h2>
            <span class="govuk-footer__licence-description">
              Case Task Service prototype.
            </span>
          </div>
        </div>
      </div>
    </footer>

    <script src="/govuk/govuk-frontend.min.js"></script>
    <script>
      window.GOVUKFrontend.initAll()
    </script>
  </body>
</html>